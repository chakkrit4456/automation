# Copy to .env, or run: node scripts/make-env.js
# Use hex/alphanumeric secrets (no @ : / #) so they are safe inside a database URL.

# Application
NODE_ENV=production
PORT=3000
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
TIMEZONE=Asia/Bangkok
# Public HTTPS address of the dashboard. OAuth redirect URIs are built from it:
#   {PUBLIC_URL}/api/social/youtube/callback   (and tiktok, instagram, facebook)
# Local dev with Vite: http://localhost:5173
PUBLIC_URL=http://localhost:3000
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
AUTOMATION_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SEED_DEMO=false
# mock = pretend to publish (safe for testing). live = upload through the official APIs.
PUBLISHER_MODE=mock

# PostgreSQL - self-hosted in Docker. docker-compose builds DATABASE_URL from these.
POSTGRES_DB=ai_social
POSTGRES_USER=ai_social
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
# Leave empty for local `npm run dev` (in-memory store). Docker sets it automatically.
DATABASE_URL=
DB_POOL_MAX=5

# n8n (first visit to the editor asks you to create the owner account)
N8N_DB_SCHEMA=n8n
N8N_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
N8N_HOST=localhost
N8N_PROTOCOL=http
# e.g. https://n8n.example.com/ when served behind Nginx + HTTPS
N8N_EDITOR_BASE_URL=
N8N_SECURE_COOKIE=false
N8N_VERSION=latest

# Claude API (console.anthropic.com - separate from a Claude Pro subscription)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Video / TTS
MEDIA_ROOT=/data/media
MAX_VIDEO_SIZE_MB=500
# edge = free Microsoft Edge voices (needs `pip install edge-tts`), none = silent video
TTS_PROVIDER=edge
# Thai voices: th-TH-PremwadeeNeural (female), th-TH-NiwatNeural (male)
TTS_VOICE=th-TH-PremwadeeNeural
# e.g. +10% to speak faster
TTS_RATE=
# Windows local dev: Leelawadee UI. Docker image ships Noto Sans Thai.
SUBTITLE_FONT=Noto Sans Thai
SUBTITLE_FONTS_DIR=

# YouTube (Google Cloud Console > OAuth client, type Web application)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# public | unlisted | private
YOUTUBE_PRIVACY=public

# Facebook + Instagram (Meta for Developers app, Facebook Login)
META_APP_ID=
META_APP_SECRET=
# Optional: pick a specific Page when your account manages several
META_PAGE_ID=
META_GRAPH_VERSION=v23.0

# TikTok (TikTok for Developers, Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Unaudited apps can only post SELF_ONLY; the app falls back automatically.
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
